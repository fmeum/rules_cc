load("@platforms_contrib//os/windows/cxx_runtime/msvcp:msvcp.bzl", "msvcp_version_constraints")
load("//cc:cc_binary.bzl", "cc_binary")
load("//cc/private/toolchain:windows_cc_toolchain_config.bzl", "cc_toolchain_config")  # buildifier: disable=bzl-visibility
load("//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":msvc_cxx_runtime_test.bzl", "msvc_cxx_runtime_tests")

platform(
    name = "windows_with_vcredist",
    constraint_values = [
        "@platforms//os:windows",
    ] + msvcp_version_constraints("14.40"),
)

filegroup(
    name = "empty",
)

cc_toolchain_config(
    name = "msvc_config",
    abi_libc_version = "local",
    abi_version = "local",
    compiler = "msvc-cl",
    cpu = "x64_windows",
    host_system_name = "local",
    target_libc = "ucrt",
    target_system_name = "local",
    tool_paths = {
        "ar": "lib.exe",
        "cpp": "cl.exe",
        "gcc": "cl.exe",
        "ld": "link.exe",
        "ml": "ml64.exe",
        "nm": "nop.bat",
        "objcopy": "nop.bat",
        "objdump": "nop.bat",
        "strip": "nop.bat",
    },
    toolchain_identifier = "msvc-test",
)

cc_toolchain(
    name = "msvc_cc_toolchain",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":msvc_config",
    toolchain_identifier = "msvc-test",
)

toolchain(
    name = "msvc_cc_toolchain_registration",
    target_compatible_with = ["@platforms//os:windows"],
    toolchain = ":msvc_cc_toolchain",
    toolchain_type = "//cc:toolchain_type",
)

cc_binary(
    name = "binary",
    srcs = ["lib.cc"],
    tags = ["manual"],
)

msvc_cxx_runtime_tests(
    name = "msvc_cxx_runtime_tests",
    target = ":binary",
)
